# ===== Telegram =====
# BotFather 提供的机器人 token
BOT_TOKEN=
# 机器人用户名（不带 @，用于 emos link 授权与支付回跳）
BOT_NAME=my_dlt_bot
# 管理员 Telegram ID（/admin 命令与告警接收）
ADMIN_TG_ID=

# ===== emos =====
# 测试服 https://test.emos.best / 正式服 https://emos.best（CF 403 时可用 https://api.emos.best）
EMOS_BASE_URL=https://test.emos.best
# 支付服务商账号 token
EMOS_TOKEN=
# 授权链接里的接入方标识（bot 开发者的 emos 用户 ID，如 eW3GMWD3Js）
# 仅用于标识接入来源、无实际功能作用；留空则自动从上面的 token 推导
EMOS_DEVELOPER_ID=

# ===== 业务 =====
TZ=Asia/Shanghai
# 注价（萝卜）
PRICE_PER_BET=2
# 返奖率：0.95 = 95% 返奖 + 5% 运营留存（必须 < 1）
PAYOUT_RATE=0.95
# 每期单人投注上限（注）
MAX_BETS_PER_USER=100

# 期次时刻（与下方 cron 对应，时区 TZ）
# 停售时刻
SALE_CLOSE_TIME=20:30
# 开奖时刻
DRAW_TIME=21:00

# ===== 调度（node-cron 表达式，时区 TZ）=====
# 每日 00:01 开新期
SELL_CRON=1 0 0 * * *
# 每日 20:30 停售
CLOSE_CRON=30 20 * * *
# 每日 21:00 开奖
DRAW_CRON=0 0 21 * * *

# ===== 服务 =====
DB_PATH=./data/dlt.db
PORT=8787
# 公网回调地址（如 https://dlt.example.com）；留空 = 纯轮询对账模式
PUBLIC_URL=
# 可选：公示频道 ID
CHANNEL_ID=

# ===== 其他 =====
NODE_ENV=production
# 置 1 输出开发友好日志
LOG_PRETTY=
