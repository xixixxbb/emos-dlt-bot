# ===== Telegram =====
BOT_TOKEN=123456:ABC-DEF...          # BotFather 提供
BOT_NAME=my_dlt_bot                  # 机器人用户名（不带 @，用于 emos link/支付回跳）
ADMIN_TG_ID=123456789                # 管理员 Telegram ID

# ===== emos =====
EMOS_BASE_URL=https://test.emos.best  # 测试服；正式服 https://emos.best（备用 api.emos.best）
EMOS_TOKEN=11_test-token              # 支付服务商账号 token

# ===== 业务 =====
TZ=Asia/Shanghai
PRICE_PER_BET=2                       # 注价（萝卜）
PAYOUT_RATE=0.95                      # 返奖率（0.95 = 95% 返奖 + 5% 运营留存）
MAX_BETS_PER_USER=100                 # 每期单人投注上限（注）

# 期次时刻（与下方 cron 对应，时区 TZ）
SALE_CLOSE_TIME=20:30                 # 停售时刻
DRAW_TIME=21:00                       # 开奖时刻

# ===== 调度（node-cron 表达式，时区 TZ）=====
SELL_CRON=1 0 0 * * *                 # 每日 00:01 开新期
CLOSE_CRON=30 20 * * *                # 每日 20:30 停售
DRAW_CRON=0 0 21 * * *                # 每日 21:00 开奖

# ===== 服务 =====
DB_PATH=./data/dlt.db
PORT=8787
PUBLIC_URL=                            # 公网回调地址（如 https://dlt.example.com）；留空 = 纯轮询对账模式
CHANNEL_ID=                            # 可选：公示频道

# ===== 其他 =====
NODE_ENV=production
LOG_PRETTY=                            # 置 1 开启开发友好日志
