[Unit]
Description=EMOS DLT Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dlt
WorkingDirectory=/opt/emos-dlt-bot
EnvironmentFile=/opt/emos-dlt-bot/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
KillSignal=SIGINT

# 加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/emos-dlt-bot/data /opt/emos-dlt-bot/backups /opt/emos-dlt-bot/logs

# 资源
MemoryMax=512M
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
